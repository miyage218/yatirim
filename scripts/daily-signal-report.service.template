[Unit]
Description=Yatirim gunluk sinyal raporu (Telegram botu)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__WORKDIR__
ExecStart=__PYTHON__ scripts/daily_signal_report.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
